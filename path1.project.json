{
  "version": 1,
  "no_self_mock": {
    "go_roots": [
      "."
    ],
    "js_roots": []
  },
  "detectors": {
    "go_roots": [
      "."
    ],
    "catalog_dir": "audit/fault-catalog"
  },
  "canaries": {
    "require_dsn": false,
    "clean_units": [],
    "items": [
      {
        "id": "CANARY-DELETE-STATUS",
        "seed": "sed -i 's/http.StatusNoContent/http.StatusOK/' {worktree}/main.go",
        "detect": "cd {worktree} && go test -run TestDeleteNote ./..."
      }
    ]
  },
  "feature_dir": {
    "artifact_globs": [
      "doc/идеи/*/{name}",
      "doc/идеи/*/*/{name}"
    ]
  },
  "graph": {
    "source_roots": [
      "web"
    ],
    "artifact_globs": [
      "arch/structure/ui-pages/*.yaml",
      "arch/structure/ui-pages/*.yml",
      "doc/идеи/*/UI-GRAPH.yaml"
    ]
  },
  "e2e": {
    "frontend_dir": "web",
    "command": "bash deploy/path1/e2e-preview.sh"
  },
  "deploy": {
    "project_id": "f41f0adb-67d9-4ddf-8ba9-0efd9c6e50a9",
    "stand_command": "bash deploy/path1/preview-deploy.sh {stand} {ref}",
    "runtime_dir": "deploy/stands/.runtime",
    "dsn_command": ""
  },
  "integration": {
    "command": "bash deploy/path1/e2e-preview.sh"
  },
  "audit": {
    "mode": "app",
    "database": false,
    "oracles": {
      "CONTRACT-STATUS-CODE": "go test -count=1 -run 'TestDeleteNote|TestDeleteErrorEnvelope|TestNotesMethodNotAllowed' ./...",
      "SEC-ERROR-LEAK": "go test -count=1 -run TestDeleteErrorEnvelope ./...",
      "SEC-WRITE-VERB-REJECT": "go test -count=1 -run TestNotesMethodNotAllowed ./...",
      "SEC-AUTH-REQUIRED": "go test -count=1 -run 'TestAuthRequired|TestLoginInvalid' ./...",
      "SEC-USER-ISOLATION": "go test -count=1 -run 'TestNotesIsolation|TestDeleteForeignNote' ./..."
    }
  }
}
