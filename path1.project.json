{
  "version": 1,
  "no_self_mock": {
    "go_roots": [
      "."
    ],
    "js_roots": []
  },
  "detectors": {
    "go_roots": [
      "."
    ],
    "catalog_dir": "audit/fault-catalog"
  },
  "canaries": {
    "require_dsn": false,
    "clean_units": [],
    "items": [
      {
        "id": "CANARY-DELETE-STATUS",
        "seed": "sed -i 's/http.StatusNoContent/http.StatusOK/' {worktree}/main.go",
        "detect": "cd {worktree} && go test -run TestDeleteNote ./..."
      },
      {
        "id": "sec-rls-predicate-drop",
        "seed": "sed -i 's/if note.UserID == userID/if note.UserID != userID/' {worktree}/main.go",
        "detect": "cd {worktree} && go test -count=1 -run 'TestNotesIsolation|TestDeleteForeignNote' ./..."
      },
      {
        "id": "sec-skip-tagged",
        "seed": "sed -i '1i //go:build integration' {worktree}/main_test.go",
        "detect": "cd {worktree} && sh -c \"! grep -R -E '^//go:build.*(integration|e2e|manual)' --include='*_test.go' .\""
      }
    ]
  },
  "feature_dir": {
    "artifact_globs": [
      "doc/идеи/*/{name}",
      "doc/идеи/*/*/{name}"
    ]
  },
  "graph": {
    "source_roots": [
      "web"
    ],
    "artifact_globs": [
      "arch/structure/ui-pages/*.yaml",
      "arch/structure/ui-pages/*.yml",
      "doc/идеи/*/UI-GRAPH.yaml"
    ]
  },
  "e2e": {
    "frontend_dir": "web",
    "command": "bash deploy/path1/e2e-preview.sh"
  },
  "deploy": {
    "project_id": "f41f0adb-67d9-4ddf-8ba9-0efd9c6e50a9",
    "stand_command": "bash deploy/path1/preview-deploy.sh {stand} {ref}",
    "runtime_dir": "deploy/stands/.runtime",
    "dsn_command": ""
  },
  "integration": {
    "command": "E2E_API_ONLY=1 bash deploy/path1/e2e-preview.sh"
  },
  "audit": {
    "mode": "app",
    "database": false,
    "oracles": {
      "CONTRACT-WIRE-CASING": "go test -count=1 -run TestWireContract ./...",
      "CONTRACT-ERROR-ENVELOPE": "go test -count=1 -run 'TestDeleteErrorEnvelope|TestNoSecretLeak' ./...",
      "CONTRACT-STATUS-CODE": "go test -count=1 -run 'TestDeleteNote|TestDeleteErrorEnvelope|TestNotesMethodNotAllowed|TestRegister|TestLogin' ./...",
      "CONTRACT-NULL-OMITEMPTY": "go test -count=1 -run 'TestNotesLifecycle|TestWireContract' ./...",
      "DATA-ADAPTER-REAL-TRANSPORT": "go test -count=1 -run TestHTTPTransport ./...",
      "DATA-SCOPE-VALIDATION": "go test -count=1 -run 'TestNotesIsolation|TestDeleteForeignNote' ./...",
      "SEC-RLS-SCOPE-PREDICATE": "go test -count=1 -run 'TestNotesIsolation|TestDeleteForeignNote' ./...",
      "SEC-SKIP-TAGGED-INVARIANT": "sh -c \"! grep -R -E '^//go:build.*(integration|e2e|manual)' --include='*_test.go' .\"",
      "SEC-PREFIX-BOUNDARY": "go test -count=1 -run 'TestDeleteInvalidID|TestNotesPrefixBoundary' ./...",
      "SEC-WRITE-VERB-REJECT": "go test -count=1 -run 'TestNotesMethodNotAllowed|TestAuthMethodOrder' ./...",
      "SEC-ERROR-LEAK": "go test -count=1 -run 'TestNoSecretLeak|TestDeleteErrorEnvelope' ./...",
      "UI-EMPTY-STATE-CONTROLS": "go test -count=1 -run TestUISemantics ./...",
      "UI-LOADING-ERROR-STATES": "go test -count=1 -run TestUISemantics ./...",
      "UI-FILTER-SERIALIZATION": "go test -count=1 -run TestUISemantics ./...",
      "UI-E2E-PREVIEW": "bash -c 'curl -fsS -m 10 https://test2.nexus.ukituki.tech/healthz >/dev/null && test \"$(curl -s -o /dev/null -w %{http_code} -m 10 https://test2.nexus.ukituki.tech/api/notes)\" = 401'",
      "SEC-AUTH-REQUIRED": "go test -count=1 -run 'TestAuthRequired|TestLoginInvalid' ./...",
      "SEC-USER-ISOLATION": "go test -count=1 -run 'TestNotesIsolation|TestDeleteForeignNote' ./..."
    }
  }
}
