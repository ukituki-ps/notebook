# Docker build context для notebook-stand (dev).
# Сборочные артефакты, рантайм-состояние стендов и e2e-зависимости в образ не нужны.
.git
/notebook
*.log
deploy/stands/.runtime/
data/

# Playwright: спека и node_modules не входят в бинарь;
# embed-файлы web/index.html, web/app.js, web/app.css остаются в контексте.
web/e2e/
web/node_modules/
