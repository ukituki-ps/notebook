{
  "schema_version": "1.0",
  "name": "Notebook DS",
  "version": "1.0.0",
  "components": [
    {
      "id": "primitives/card",
      "selector": ".card",
      "source": "web/app.css",
      "states": [
        "default"
      ]
    },
    {
      "id": "primitives/button",
      "selector": "button",
      "source": "web/app.css",
      "states": [
        "default",
        "hover",
        "focus",
        "disabled"
      ]
    },
    {
      "id": "primitives/button-secondary",
      "selector": ".logout",
      "source": "web/app.css",
      "states": [
        "default",
        "hover",
        "focus"
      ]
    },
    {
      "id": "primitives/input",
      "selector": "input",
      "source": "web/app.css",
      "states": [
        "default",
        "focus",
        "invalid"
      ]
    },
    {
      "id": "primitives/textarea",
      "selector": "textarea",
      "source": "web/app.css",
      "states": [
        "default",
        "focus",
        "invalid"
      ]
    },
    {
      "id": "primitives/error",
      "selector": ".error",
      "source": "web/app.css",
      "states": [
        "default"
      ]
    },
    {
      "id": "patterns/notes-header",
      "selector": ".notes-header",
      "source": "web/app.css",
      "states": [
        "default"
      ]
    },
    {
      "id": "patterns/notes-list",
      "selector": ".notes-list",
      "source": "web/app.css",
      "states": [
        "default"
      ]
    },
    {
      "id": "patterns/note-item",
      "selector": ".note-item",
      "source": "web/app.css",
      "states": [
        "default",
        "pending"
      ]
    },
    {
      "id": "patterns/search-field",
      "selector": ".notes-search",
      "source": "web/app.css",
      "states": [
        "default",
        "focus"
      ]
    },
    {
      "id": "patterns/search-clear",
      "selector": ".notes-search-clear",
      "source": "web/app.css",
      "states": [
        "default",
        "focus"
      ]
    },
    {
      "id": "states/loading",
      "selector": "[data-testid=\"notes-loading\"]",
      "source": "web/app.css",
      "states": [
        "loading"
      ]
    },
    {
      "id": "states/empty",
      "selector": "[data-testid=\"notes-empty\"]",
      "source": "web/app.css",
      "states": [
        "empty"
      ]
    },
    {
      "id": "states/search-empty",
      "selector": "[data-testid=\"notes-search-empty\"]",
      "source": "web/app.css",
      "states": [
        "empty"
      ]
    }
  ]
}
