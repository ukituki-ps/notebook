{
  "schema_version": "1.0",
  "screen_id": "note-search",
  "unit_id": "note-search",
  "platform": "web",
  "design_system_version": "1.0.1",
  "ds_digest": "sha256:4e0ef1052a1401a928588445f921f7d231b7c0e7c9b10c181fdbbb439108c85e",
  "screen_brief": "Owner-scoped note search over Notebook DS: search field, clear, idle/results/empty/loading/error/offline, 390/1200, read-only list with delete.",
  "brief_coverage": [
    {
      "brief_state": "search field",
      "covered_by": ["n-search-field", "n-search-clear"],
      "proto_states": ["normal", "idle", "results", "no-results", "loading", "error", "offline", "offline-zero"]
    },
    {
      "brief_state": "clear",
      "covered_by": ["n-search-clear"],
      "proto_states": ["results", "no-results"]
    },
    {
      "brief_state": "idle",
      "covered_by": ["n-notes-header", "n-note-form", "n-search-field", "n-notes-list", "n-note-item", "n-delete"],
      "proto_states": ["normal", "idle"]
    },
    {
      "brief_state": "results",
      "covered_by": ["n-search-field", "n-search-clear", "n-count", "n-notes-list", "n-note-item", "n-delete"],
      "proto_states": ["results"]
    },
    {
      "brief_state": "empty",
      "covered_by": ["n-empty"],
      "proto_states": ["empty", "offline-zero"]
    },
    {
      "brief_state": "loading",
      "covered_by": ["n-loading"],
      "proto_states": ["loading"]
    },
    {
      "brief_state": "error",
      "covered_by": ["n-error", "n-retry"],
      "proto_states": ["error"]
    },
    {
      "brief_state": "offline",
      "covered_by": ["n-offline", "n-offline-check"],
      "proto_states": ["offline", "offline-zero"]
    },
    {
      "brief_state": "read-only list with delete",
      "covered_by": ["n-notes-list", "n-note-item", "n-delete"],
      "proto_states": ["normal", "idle", "results", "offline"]
    }
  ],
  "breakpoints": [
    {
      "width": 390,
      "layout": "mobile: search row stacked, full-width 44px controls, no horizontal scroll; note rows wrap with delete aligned right",
      "exports": ["exports/export-390-idle.png", "exports/export-390-results.png", "exports/export-390-no-results.png", "exports/export-390-empty.png", "exports/export-390-loading.png", "exports/export-390-error.png", "exports/export-390-offline.png"]
    },
    {
      "width": 1200,
      "layout": "desktop: centered column/card, inline search field + clear, count above the list",
      "exports": ["exports/export-1200-idle.png", "exports/export-1200-results.png", "exports/export-1200-no-results.png", "exports/export-1200-empty.png", "exports/export-1200-loading.png", "exports/export-1200-error.png", "exports/export-1200-offline.png"]
    }
  ],
  "domain_states": [
    {
      "state": "offline",
      "applicable": true,
      "proto_states": ["offline", "offline-zero"],
      "description": "Network loss: cached/loaded notes stay readable, search and delete are disabled, banner offers «Проверить сеть»."
    },
    {
      "state": "blocked",
      "applicable": false,
      "reason": "No blocking domain state in note search: auth failure is a 401 branch that clears the query and redirects to login (no rendered blocked screen)."
    },
    {
      "state": "over-budget",
      "applicable": false,
      "reason": "Note search has no budget/quota UI; the only limit is the 512-byte q cap enforced by the API (400 envelope), which is not a screen state."
    }
  ],
  "states": [
    "normal",
    "idle",
    "results",
    "no-results",
    "empty",
    "loading",
    "error",
    "offline",
    "offline-zero"
  ],
